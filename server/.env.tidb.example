# Copy to server/.env.tidb (ignored by Git) and restrict its permissions to 600.
# Use the values from your TiDB Cloud instance's Connect panel.
DB_HOST=your-instance-endpoint.tidbcloud.com
DB_PORT=4000
DB_USER=your-tidb-username
DB_PASSWORD=replace_with_your_password
DB_NAME=starbase
DB_SSL=true
# Node's built-in CA roots work for TiDB Cloud Starter public endpoints.
# For a provider-supplied CA, use an absolute local path:
# DB_SSL_CA=/absolute/path/to/ca.pem
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_ORIGIN=https://your-frontend.example
